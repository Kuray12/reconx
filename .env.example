# ReconX configuration - copy this file to ".env" and fill in your own values.
#   cp .env.example .env
#
# The scan target is typed in interactively when you choose "Deep Scan".
# Everything here is optional except OPERATOR_NAME (used in reports).

# Operator name, written into every report for accountability.
OPERATOR_NAME=

# ---------------------------------------------------------------------------
# NOTIFICATIONS  (optional - only ever sends to YOUR OWN channel/inbox)
# ---------------------------------------------------------------------------
# Telegram: talk to @BotFather to create a bot and get the token.
# Then message your bot and read the chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP) report delivery - use an app password, never your real one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
